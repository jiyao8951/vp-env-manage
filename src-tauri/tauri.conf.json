{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlowDeck",
  "version": "0.1.0",
  "identifier": "dev.flowdeck.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1520",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FlowDeck",
        "width": 1200,
        "height": 660,
        "resizable": false,
        "maximizable": false,
        "minimizable": true,
        "fullscreen": false,
        "decorations": false,
        "center": true,
        "dragDropEnabled": false,
        "titleBarStyle": "Transparent"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
